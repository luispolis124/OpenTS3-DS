# ==============================================================================
# OpenTS3-DS - GitIgnore
# Proteção para Código Fonte, Scripts, Ferramentas e Preservação de Direitos Autorais
# ==============================================================================

# --- ROMs e Mídia Proprietária (NUNCA SUBIR PRO GITHUB) ---
*.nds
*.NDS
*.srl
*.SRL
*.bin
*.BIN

# --- Dump de Arquivos Extraídos e Assets do Jogo ---
/dump/
/extracted/
/data_dump/
/NitroFS/
/LOCALIZATION/
*.arc
*.dat
*.package

# --- Arquivos de Saída dos Scripts Python/Ferramentas ---
*.txt
!docs/*.txt
!README.md
*.json
!manifest.json
*.csv

# --- Arquivos de Save e Emulação ---
*.sav
*.dsv
*.sta
*.sgm
*.ss1
*.ss2

# --- Projetos e Caches de Engenharia Reversa (Ghidra / Radare2 / Tinke) ---
*.gpr
*.rep/
*.gdt
.r2/
.radare2
tinke_temp/

# --- Python (Caches dos Scripts de Extração/Injeção) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# --- Compilação, Binários e Arquivos Temporários C/C++ ---
*.d
*.o
*.ko
*.obj
*.elf
*.ilk
*.map
*.exp
*.gch
*.pch
*.lib
*.a
*.la
*.lo
*.dll
*.so
*.so.*
*.dylib
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex
*.dSYM/
*.su
*.idb
*.pdb
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf
*.dwo

# --- Diretórios de Build e Saídas de Compilação ---
/build/
/out/
/dist/
deps/

# --- Arquivos de Configuração de IDEs e Editores ---
.vscode/
.vs/
.idea/
*.swp
*~

# --- Caches de Sistema Operacional ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
